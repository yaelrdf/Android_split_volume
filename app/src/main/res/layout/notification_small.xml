<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="@string/side_l"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/l_minus"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/notif_button_bg"
        android:gravity="center"
        android:contentDescription="@string/cd_l_down"
        android:text="@string/minus"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="20sp" />
    <TextView
        android:id="@+id/l_value"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />
    <TextView
        android:id="@+id/l_plus"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/notif_button_bg"
        android:gravity="center"
        android:contentDescription="@string/cd_l_up"
        android:text="@string/plus"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="20sp" />
    <!-- Weighted spacer; RemoteViews doesn't support Space, so lint's UselessLeaf is a false positive. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        tools:ignore="UselessLeaf" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="@string/side_r"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/r_minus"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/notif_button_bg"
        android:gravity="center"
        android:contentDescription="@string/cd_r_down"
        android:text="@string/minus"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="20sp" />
    <TextView
        android:id="@+id/r_value"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />
    <TextView
        android:id="@+id/r_plus"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/notif_button_bg"
        android:gravity="center"
        android:contentDescription="@string/cd_r_up"
        android:text="@string/plus"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textSize="20sp" />
</LinearLayout>
